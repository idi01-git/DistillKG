{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "metadata": {
    "title": "Industrial Continuous Distillation Column & TEP P&ID Knowledge Graph",
    "version": "1.0.0",
    "description": "Deterministic physical topology, sensor-equipment bindings, and dynamic regime-modulated causal edges for continuous distillation column fault diagnosis."
  },
  "subsystems": [
    {
      "id": "SUB_FEED",
      "name": "Feed Preheating & Delivery Subsystem",
      "description": "Feed storage, supply manifolds, preheating exchangers, and column feed tray nozzles."
    },
    {
      "id": "SUB_COLUMN",
      "name": "Distillation Column Internal Trays",
      "description": "Multi-stage fractionation shell, stripping section, rectifying section, and mid-column trays (Tray 6)."
    },
    {
      "id": "SUB_OVERHEAD",
      "name": "Overhead Vapor & Condensation Subsystem",
      "description": "Overhead vapor riser, total condenser heat exchanger, and off-gas vent purge line."
    },
    {
      "id": "SUB_REFLUX",
      "name": "Reflux Accumulator & Distillate Take-off",
      "description": "Reflux drum, reflux return pump, distillate draw line, and reflux control loop."
    },
    {
      "id": "SUB_REBOILER",
      "name": "Reboiler & Bottoms Product Subsystem",
      "description": "Column sump reservoir, thermosiphon steam reboiler, boilup vapor line, and bottoms product draw."
    }
  ],
