  "fault_nodes": [
    {
      "id": "Fault_1",
      "name": "Feed A/C Ratio Disturbance",
      "subsystem": "SUB_FEED",
      "initiating_component": "EQ_FEED_MANIFOLD",
      "mechanism": "Step change in upstream A/C feed composition shifts molar density into column."
    },
    {
      "id": "Fault_2",
      "name": "Component B Composition Shift (VLE Displacement)",
      "subsystem": "SUB_FEED",
      "initiating_component": "EQ_FEED_TRAY",
      "mechanism": "Feed B composition drift alters vapor-liquid equilibrium (VLE) curve across all trays."
    },
    {
      "id": "Fault_5",
      "name": "Condenser Cooling Water Temperature Step",
      "subsystem": "SUB_OVERHEAD",
      "initiating_component": "EQ_CONDENSER",
      "mechanism": "Cooling water temperature spike reduces log-mean temperature difference (LMTD), elevating column pressure."
    },
    {
      "id": "Fault_6",
      "name": "Feed A Starvation (Weeping Hazard)",
      "subsystem": "SUB_FEED",
      "initiating_component": "EQ_FEED_MANIFOLD",
      "mechanism": "Sudden reduction in light component feed lowers tray liquid head, risking tray weeping."
    },
    {
      "id": "Fault_11",
      "name": "Reactor Cooling Water Valve Sticking",
      "subsystem": "SUB_FEED",
      "initiating_component": "EQ_REACTOR",
      "mechanism": "Mechanical stiction in reactor cooling water valve XMV(10) disrupts thermal runaway control in CSTR."
    },
    {
      "id": "Fault_15",
      "name": "Condenser Cooling Valve Stiction",
      "subsystem": "SUB_OVERHEAD",
      "initiating_component": "EQ_CONDENSER",
      "mechanism": "Valve deadband stiction generates limit-cycle oscillations in overhead pressure."
    },
    {
      "id": "Fault_Debutanizer_Reflux_Loss",
      "name": "Debutanizer Reflux Pump Degradation",
      "subsystem": "SUB_REFLUX",
      "initiating_component": "EQ_REFLUX_LOOP",
      "mechanism": "Reflux flow drops, diminishing internal liquid downflow and allowing heavy butane to vaporize overhead."
    },
    {
      "id": "Fault_Debutanizer_Reboiler_Fouling",
      "name": "Debutanizer Reboiler Steam Tube Fouling",
      "subsystem": "SUB_REBOILER",
      "initiating_component": "EQ_REBOILER",
      "mechanism": "Overall heat transfer coefficient U declines, forcing steam valve to 100% saturation."
    }
  ],
